# Copy to .env and edit. Never commit the real file.
ENVIRONMENT=prod
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/"]

# Seconds NoneBot waits for NapCat to answer an API call. Image uploads to QQ can be slow.
API_TIMEOUT=180

# Must match the token configured in NapCat's OneBot reverse WebSocket client.
ONEBOT_ACCESS_TOKEN=change-me-to-a-long-random-string

# Keep plugin data under ./data, ./cache and ./config next to bot.py.
LOCALSTORE_USE_CWD=true

# QQ numbers allowed to use administrator commands.
SUPERUSERS=["123456789"]

# Pools per category drawn in one /zmd抽卡记录 image before it is split into several pages.
# The upstream default is 5; a higher value means fewer pages but taller images.
SKLAND__EF_GACHA_RENDER_MAX=8
