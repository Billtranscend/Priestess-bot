# 复制成 .env 再改。真正的 .env 不要提交。
ENVIRONMENT=prod
DRIVER=~fastapi
# NoneBot 在这里等 NapCat 用反向 WebSocket 连进来，只听 127.0.0.1。
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
COMMAND_START=["/"]

# 等 NapCat 回应的秒数。往 QQ 传图可能很慢，别调小。
API_TIMEOUT=180

# 和 NapCat「网络配置」里那个 Websocket客户端的 Token 一样。
ONEBOT_ACCESS_TOKEN=change-me-to-a-long-random-string

# 插件数据放在 bot.py 旁边的 ./data、./cache、./config。
LOCALSTORE_USE_CWD=true

# 能用管理指令的 QQ 号。不能空着，空着机器人起不来。
SUPERUSERS=["123456789"]

# 旁边跑着 nonebot-bison 的话打开，帮助图（/skl帮助）里会列出它的订阅指令。
# HELP_BISON=true

# 机器人正忙、定时任务（夜间签到、榜单）没按时开始的话，15 分钟内还会补跑，不会直接跳到第二天。
APSCHEDULER_CONFIG='{"apscheduler.timezone": "Asia/Shanghai", "apscheduler.job_defaults.misfire_grace_time": 900, "apscheduler.job_defaults.coalesce": true}'
