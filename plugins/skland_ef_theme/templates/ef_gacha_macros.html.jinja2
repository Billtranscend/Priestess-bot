{# 终末地单卡池渲染宏 #}
{% macro ef_pool_card(pool, pool_label, pool_color, gacha_data=none, gifts=none) %}
{% set stats = namespace(pity_count=0, five_stars=[], paid=0) %}
{# 累计抽数赠送（信物 / 武库箱 / UP 武器等）：{第 N 个付费抽: [赠品]}，由 skland_ef_theme 注入 #}
{% set pool_gifts = (gifts or {}).get(pool.pool_id, {}) %}
{% set show_spook = pool.show_spook_stats %}

<div class="pool">
    {# 卡池头部 #}
    {# Banner 装饰图 (1151×146 宽幅横条)；无图时不占位 #}
    {% if pool.up6_img %}
    <div class="banner">
        <img src="{{ pool.up6_img }}" />
    </div>
    {% endif %}

    {# 卡池名称 + 抽数 #}
    <div class="ph">
        <div class="pn">
            <b>{{ pool.pool_name }}</b>
            {% if pool.up_six_chars %}
            <div class="up">
                <span>UP</span>
                {% for up_char_id in pool.up_six_chars %}
                <img src="{{ up_char_id | ef_charId_to_avatarUrl }}" />
                {% endfor %}
            </div>
            {% endif %}
        </div>
        {# 抽数不含免费十连；免费十连单独标出 #}
        <div class="pcs">
            <div class="pc">
                <b>{{ pool.paid_pulls }}</b>
                <small>抽</small>
            </div>
            {% if pool.free_pulls %}
            <div class="pf">另 免费{{ pool.free_pulls }}抽</div>
            {% endif %}
        </div>
    </div>

    {# 卡池统计条 #}
    <div class="ps">
        <div>
            <b><span class="six">{{ pool.total_six_stars }}</span>{% if show_spook %}<i>/</i><span class="spook">{{ pool.total_six_spook }}</span>{% endif %}</b>
            <small>{% if show_spook %}6★/歪{% else %}6★{% endif %}</small>
        </div>
        <div>
            <b>{{ pool.pity_count }}</b>
            <small>已垫</small>
        </div>
    </div>

    {# 卡池记录列表 #}
    <div class="recs">
        {% for record in pool.records | reverse %}
        {# 分离免费和付费抽 #}
        {% set free_pulls_in_group = record.pulls | selectattr('is_free') | list %}
        {% set paid_pulls_in_group = record.pulls | rejectattr('is_free') | list %}

        {# ── 免费十连条目（不计入保底） ── #}
        {% if free_pulls_in_group %}
        {% set free_sixes = free_pulls_in_group | selectattr('rarity', 'equalto', 6) | list %}
        {% set free_fives = free_pulls_in_group | selectattr('rarity', 'equalto', 5) | list %}
        {% if free_sixes %}
        {# 免费十连出了6★，每个6★单独显示 #}
        {% set multi_free_six = free_sixes | length >= 2 %}
        {% set free_six_idx = namespace(value=0) %}
        {% for pull in free_sixes | reverse %}
        {% set free_six_idx.value = free_six_idx.value + 1 %}
        <div class="rec free{% if multi_free_six %} multi{% endif %}">
            {% if free_six_idx.value == free_sixes | length %}
            <div class="grp free">
                <span>免费十连{% if multi_free_six %} · {{ free_sixes | length }}金{% endif %}</span>
            </div>
            {% endif %}

            <div class="rr">
                {# 左侧：角色头像 + 日期 #}
                <div class="ra">
                    <img src="{{ pull.item_id | ef_charId_to_avatarUrl }}" class="av" />
                    <span class="date">{{ record.gacha_ts | format_timestamp_md }}</span>
                </div>

                {# 右侧：角色名 + 进度条 + 五星 #}
                <div class="rb">
                    <div class="rn">
                        <b>{{ pull.item_name }}</b>
                        {% if show_spook and pull.item_id not in pool.up_six_chars %}
                        <span class="t spk">歪</span>
                        {% endif %}
                        {% if pool.up_six_chars and pull.item_id in pool.up_six_chars %}
                        <span class="t up">UP</span>
                        {% endif %}
                        <span class="t free">免费十连</span>
                    </div>
                    <div class="free-bar">
                        <span>不计入抽数与保底</span>
                    </div>
                    {# 免费十连中出的5星 #}
                    {% if free_six_idx.value == 1 and free_fives %}
                    <div class="fives">
                        {% for group in free_fives | sort(attribute='item_id') | groupby('item_id') %}
                        <div>
                            <img src="{{ group.list[0].item_id | ef_charId_to_avatarUrl }}" />
                            {% if group.list | length > 1 %}
                            <span>{{ group.list | length }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
        {% else %}
        {# 免费十连未出6★，显示汇总条目 #}
        <div class="rec free">
            <div class="rr">
                <div class="ra">
                    <div class="av box">免费</div>
                    <span class="date">{{ record.gacha_ts | format_timestamp_md }}</span>
                </div>
                <div class="rb">
                    <div class="rn">
                        <b>免费十连</b>
                        <span class="t free">免费</span>
                    </div>
                    <div class="free-bar">
                        <span>未出6★ · 不计入抽数与保底</span>
                    </div>
                    {# 免费十连中出的5星 #}
                    {% if free_fives %}
                    <div class="fives">
                        {% for group in free_fives | sort(attribute='item_id') | groupby('item_id') %}
                        <div>
                            <img src="{{ group.list[0].item_id | ef_charId_to_avatarUrl }}" />
                            {% if group.list | length > 1 %}
                            <span>{{ group.list | length }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}
        {% endif %}

        {# ── 付费抽卡记录（正常保底逻辑） ── #}
        {% if paid_pulls_in_group %}
        {% set six_count = paid_pulls_in_group | selectattr('rarity', 'equalto', 6) | list | length %}
        {% set is_multi_six = six_count >= 2 %}
        {% set six_index = namespace(value=0) %}

        {% for pull in paid_pulls_in_group | reverse %}
        {% set stats.pity_count = stats.pity_count + 1 %}
        {% set stats.paid = stats.paid + 1 %}

        {% if pull.rarity == 5 %}
        {% set stats.five_stars = stats.five_stars + [pull] %}
        {% endif %}

        {% if pull.rarity == 6 %}
        {% set six_index.value = six_index.value + 1 %}

        <div class="rec{% if is_multi_six %} multi{% endif %}{% if is_multi_six and six_index.value == six_count %} lead{% endif %}">
            {% if is_multi_six and six_index.value == six_count %}
            <div class="grp">
                <span>十连{{ six_count }}金</span>
            </div>
            {% endif %}

            <div class="rr">
                {# 左侧：角色头像 + 日期 #}
                <div class="ra">
                    <img src="{{ pull.item_id | ef_charId_to_avatarUrl }}" class="av" />
                    <span class="date">{{ record.gacha_ts | format_timestamp_md }}</span>
                </div>

                {# 右侧：角色名（压在进度条上方）+ 进度条 + 五星头像 #}
                <div class="rb">
                    {# 角色名 + 标记，压在进度条上方 #}
                    <div class="rn">
                        <b>{{ pull.item_name }}</b>
                        {% if show_spook and pull.item_id not in pool.up_six_chars %}
                        <span class="t spk">歪</span>
                        {% endif %}
                        {% if pool.up_six_chars and pull.item_id in pool.up_six_chars %}
                        <span class="t up">UP</span>
                        {% endif %}
                        {% if pull.is_new %}
                        <span class="t new">NEW</span>
                        {% endif %}
                        {% if stats.pity_count <= 10 or stats.pity_count >= 70 %}
                        <span class="t {% if stats.pity_count <= 10 %}lucky{% else %}unlucky{% endif %}">
                            {% if stats.pity_count <= 10 %}超欧{% elif stats.pity_count >= 70 %}超非{% endif %}
                        </span>
                        {% endif %}
                    </div>
                    {# 进度条（抽数显示在条内，限定最小宽度） #}
                    {% set bar_class = 'green-stripe-bar' %}
                    {% if stats.pity_count >= 70 %}
                    {% set bar_class = 'red-stripe-bar' %}
                    {% elif stats.pity_count >= 45 %}
                    {% set bar_class = 'yellow-stripe-bar' %}
                    {% endif %}
                    <div class="pity {{ bar_class }}"
                        style="width: {{ [15 + (stats.pity_count / 80) * 85, 100] | min }}%; min-width: 40px;">
                        <span>{{ stats.pity_count }}抽</span>
                    </div>
                    {# 中间出的5星（头像形式，重复角色带数字角标） #}
                    {% if stats.five_stars %}
                    <div class="fives">
                        {% for group in stats.five_stars | sort(attribute='item_id') | groupby('item_id') %}
                        <div>
                            <img src="{{ group.list[0].item_id | ef_charId_to_avatarUrl }}" />
                            {% if group.list | length > 1 %}
                            <span>{{ group.list | length }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
        {% set stats.pity_count = 0 %}
        {% set stats.five_stars = [] %}
        {% endif %}

        {# ── 这一抽触发的累计赠送（不是抽出来的，不占抽数） ── #}
        {% for gift in pool_gifts.get(stats.paid, []) %}
        <div class="rec gift">
            <div class="rr">
                <div class="ra">
                    {% if gift.icon %}
                    <img src="{{ gift.icon | ef_charId_to_avatarUrl }}" class="av" />
                    {% else %}
                    <div class="av box">赠</div>
                    {% endif %}
                    <span class="date">{{ record.gacha_ts | format_timestamp_md }}</span>
                </div>
                <div class="rb">
                    <div class="rn">
                        <b>{{ gift.name }}</b>
                        <span class="t gift">赠送</span>
                    </div>
                    <div class="gift-bar">
                        <span>满{{ gift.at }}抽赠送 · 非抽取</span>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
        {% endfor %}
        {% endif %}

        {% endfor %}
    </div>
</div>
{% endmacro %}
